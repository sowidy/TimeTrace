TIMETRACE_DB_HOST=127.0.0.1
TIMETRACE_DB_PORT=3306
TIMETRACE_DB_USER=timetrace
TIMETRACE_DB_PASSWORD=
TIMETRACE_DB_NAME=timetrace
# 1 initializes missing tables; 0 checks existing tables without DDL.
TIMETRACE_DB_INIT_SCHEMA=1
TIMETRACE_HOST=0.0.0.0
TIMETRACE_PORT=8000
TIMETRACE_ADMIN_TOKEN=
TIMETRACE_MAX_DAYS=400
TIMETRACE_MAX_APPS=2000

# Send yesterday's complete report at 00:03 in the server's local timezone.
TIMETRACE_MAIL_TIME=00:03:00
TIMETRACE_MAIL_TRACKING=1
# Plain-text detail limits (0 displays all); charts group remaining time as Other.
TIMETRACE_MAIL_MAX_APPS=60
TIMETRACE_MAIL_MAX_SITES=40
TIMETRACE_MAIL_CHART_SERIES=8
# Optional SMTP; empty host disables mail and never prevents receiving uploads.
TIMETRACE_SMTP_HOST=
TIMETRACE_SMTP_PORT=465
TIMETRACE_SMTP_USER=
TIMETRACE_SMTP_PASSWORD=
TIMETRACE_SMTP_SSL=1
TIMETRACE_MAIL_FROM=
TIMETRACE_MAIL_ENABLED=1
TIMETRACE_MAIL_SCHEDULER=1
TIMETRACE_MAIL_CATCHUP_DAYS=2
TIMETRACE_MAIL_WEEKLY_DAY=6
